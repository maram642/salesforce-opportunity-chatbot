# Copy this file to .env and fill in your values. NEVER commit .env.
# Leave the SF_* values empty to run on data/opportunities.csv instead.

SF_USERNAME=
SF_PASSWORD=
SF_TOKEN=
# 'test' = sandbox, 'login' = production or free Developer Edition org
SF_DOMAIN=login

# Force a source: auto (default) | salesforce | csv
# DATA_SOURCE=auto

# Use the zero-shot Hugging Face model for intents (needs transformers + torch)
# USE_ZERO_SHOT=0
